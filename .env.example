# Where the database and the vault live (use a folder on the NVMe drive).
WEIRDTV_DATA_DIR=/var/lib/weird-tv
# Boards to scrape, comma-separated.
WEIRDTV_BOARDS=wsg
# Vault size limit in MB.
WEIRDTV_ARCHIVE_MAX_MB=2048
# e.g. 02:00-06:00: the station goes off air (test card + tone).
WEIRDTV_QUIET_HOURS=
WEIRDTV_TIMEZONE=Europe/Budapest

# gunicorn: 0.0.0.0 makes it reachable from the home network, 127.0.0.1 from the Pi only.
HOST=0.0.0.0
PORT=8088
